# --- Neon (Project dashboard > Connect > pooled connection string) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Claude API (console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5     # cheap and fast; switch to claude-sonnet-5-5 for harder chats

# --- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp) ---
WHATSAPP_TOKEN=                      # permanent system-user token in production
WHATSAPP_APP_SECRET=                 # App settings > Basic > App secret (verifies webhooks)
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
GRAPH_API_VERSION=v21.0

# --- Paystack (dashboard.paystack.com > Settings > API Keys) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PUBLIC_BASE_URL=https://your-app.vercel.app
GUEST_EMAIL_DOMAIN=guests.kmlabs.ng  # Paystack needs an email; used when a guest gives none

# --- Owner alerts on WhatsApp (optional, needs an approved template) ---
OWNER_WHATSAPP=2348012345678
OWNER_ALERT_TEMPLATE=owner_alert     # template with one body variable {{1}}
OWNER_ALERT_TEMPLATE_LANG=en

# --- Dashboard login ---
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=change-me

# Minutes an unpaid booking holds a room before it is released
BOOKING_HOLD_MINUTES=30
